{%- comment -%}
  Layout "half_horizontal". Same structure as "full" — the Framework
  recalculates the dimensions for the layout automatically.
{%- endcomment -%}
{% if svg_url %}
  <div class="layout layout--stretch">
    <img class="image image--contain image-dither w--full h--full" src="{{ svg_url }}">
    <div class="flex flex--col flex--center portrait:hidden">
      <span class="title title--large lg:title--xxlarge">{{ location }}</span>
      <span class="description description--large lg:description--xxlarge">{{ country }}{% if population_label %} · {{ population_label }}{% endif %}</span>
      <span class="description lg:description--xlarge text--gray-45 1bit:text--black 2bit:text--gray-30">{{ coords_label }}</span>
    </div>
  </div>
{% else %}
  <div class="layout layout--center">
    <span class="title">Map unavailable</span>
  </div>
{% endif %}
{% render "souvenir_title_bar", location: location, country: country, population_label: population_label %}
