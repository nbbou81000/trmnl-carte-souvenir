{%- comment -%}
  "Souvenir map title bar" component: custom pin icon + place name +
  country/population, with a fallback for before polling has any data.
{%- endcomment -%}
{% template souvenir_title_bar %}
<div class="title_bar">
  <img class="image" src="{{ icon_src }}">
  {% if location %}
    <span class="title">{{ location }}</span>
    <span class="instance">{{ country }}{% if population_label %} · {{ population_label }}{% endif %}</span>
  {% else %}
    <span class="title">Souvenir Map</span>
    <span class="instance">Loading…</span>
  {% endif %}
</div>
{% endtemplate %}
